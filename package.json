{
  "name": "backend-satria",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "npx prisma generate && tsc && rm -rf dist/generated && cp -R src/generated dist/generated",
    "start": "node dist/server.js",
    "seed": "npx ts-node prisma/seed.ts",
    "seed:bookmarks": "npx ts-node prisma/seed-bookmarks.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "migrate": "npx prisma migrate deploy",
    "migrate:dev": "npx prisma migrate dev",
    "migrate:supabase": "bash scripts/migrate-to-supabase.sh",
    "deploy": "npm run build && npm run migrate",
    "docker:build": "docker build -t satria-api:latest .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f api",
    "docker:seed": "docker-compose exec api npm run seed",
    "prod": "NODE_ENV=production node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "openapi-types": "^12.1.3",
    "pg": "^8.20.0",
    "prisma": "^7.6.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
