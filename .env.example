# Database Configuration
# PostgreSQL connection string for production
DATABASE_URL="postgresql://satria_user:your_secure_password_here@your-host.railway.app:5432/satria_db?schema=public"

# JWT Configuration
# Secret key for JWT token signing (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="your_jwt_secret_key_here_generate_with_crypto"

# Server Configuration
NODE_ENV="production"
PORT=5000

# CORS Configuration
# Comma-separated list of allowed origins (e.g., "https://yourdomain.com,https://app.yourdomain.com")
CORS_ORIGIN="http://localhost:3000"

# Optional: Rate limiting and security
# API_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX_REQUESTS=100

# Optional: Logging level
# LOG_LEVEL="info"

# Docker-specific (used by docker-compose)
DB_USER=satria_user
DB_PASSWORD=your_secure_password_here
DB_NAME=satria_db
DB_HOST=postgres
DB_PORT=5432
