# Database Configuration
# PostgreSQL connection string for production
# Supabase direct example:
# DATABASE_URL="postgresql://postgres:your_supabase_password@db.your-project-ref.supabase.co:5432/postgres?schema=public&sslmode=require"
DATABASE_URL="postgresql://postgres.kxhsuzulmnpixxyzeadj:satria-database@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# JWT Configuration
# Use a long random secret in production. The server will refuse to start in production if this is missing
# or still set to a placeholder/default value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="satria-backend"

# Server Configuration
NODE_ENV="production"
PORT=5000

# CORS Configuration
# Set this to your frontend origin in production, for example: https://your-frontend-domain.com
# Use * to allow all browser origins temporarily while debugging production CORS issues.
# Requests from the backend's own Swagger/docs origin are allowed automatically.
CORS_ORIGIN="http://localhost:3000"

# Public API URL used by Swagger/OpenAPI in production.
# Set this on Render to your exact backend URL, for example: https://your-service.onrender.com
PUBLIC_API_BASE_URL="http://localhost:5000"

# Optional: Rate limiting and security
# API_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX_REQUESTS=100

# Optional: Logging level
# LOG_LEVEL="info"

# Docker-specific (used by docker-compose)
DB_USER=satria_user
DB_PASSWORD=satria-backend-mantab
DB_NAME=satria_db
DB_HOST=postgres
DB_PORT=5432

SUPABASE_DATABASE_URL="postgresql://postgres:satria-database@db.kxhsuzulmnpixxyzeadj.supabase.co:5432/postgres?schema=public&sslmode=require"
LOCAL_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/satria_db?schema=public"
