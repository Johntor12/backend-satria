# Database Configuration
# PostgreSQL connection string for production
DATABASE_URL="postgresql://satria_user:satria-backend-mantab@backend-satria-production.up.railway.app/:5432/satria_db?schema=public"

# JWT Configuration
# Secret key for JWT token signing (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="210e563153c5bba496dd26d42fcb95407e50dc9639066daa89f37b87a5207a5a"

# Server Configuration
NODE_ENV="production"
PORT=5000

# CORS Configuration
# Comma-separated list of allowed origins (e.g., "https://yourdomain.com,https://app.yourdomain.com")
CORS_ORIGIN="http://localhost:3000"

# Optional: Rate limiting and security
# API_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX_REQUESTS=100

# Optional: Logging level
# LOG_LEVEL="info"

# Docker-specific (used by docker-compose)
DB_USER=satria_user
DB_PASSWORD=satria-backend-mantab
DB_NAME=satria_db
DB_HOST=postgres
DB_PORT=5432
