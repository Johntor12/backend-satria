// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RiskTier {
  Critical
  High
  Medium
  Low
}

enum BookmarkStatus {
  Active
  Archived
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  username  String    @unique
  fullName  String?
  companies CompanyCollection[]
  bookmarks Bookmark[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model CompanyCollection {
  id                    Int      @id @default(autoincrement())
  userId                Int
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName           String
  companyNickname       String
  sector                String
  riskScore             Int
  riskTier              RiskTier
  etr_score             Float    @default(0)
  margin_score          Float    @default(0)
  rp_haven_score        Float    @default(0)
  debt_score            Float    @default(0)
  ownership_score       Float    @default(0)
  conduct_score         Float    @default(0)
  persistence_multiplier Float    @default(1.0)
  methods               String[]
  revenue               Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  bookmarks             BookmarkCompany[]
}

model Bookmark {
  id          Int               @id @default(autoincrement())
  userId      Int
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  companies   BookmarkCompany[]
  status      BookmarkStatus    @default(Active)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model BookmarkCompany {
  id              Int               @id @default(autoincrement())
  bookmarkId      Int
  bookmark        Bookmark          @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  companyId       Int
  company         CompanyCollection @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookmarkedAt    DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([bookmarkId, companyId])
}
